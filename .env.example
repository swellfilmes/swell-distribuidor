# =========================================================
# Chaves do projeto Swell Distribuidor
# Copie este arquivo para `.env` e preencha cada linha.
# Nunca commite o `.env` no git.
#
# A partir da F2.1, segredos de cada empresa (Notion, Zernio) ficam no
# Postgres em tenant_secrets. O .env só guarda chaves GLOBAIS do sistema.
# =========================================================

# --- Claude (cérebro: classifica vídeo e gera copy) ---
# Pegar em: https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=

# --- Cloudflare R2 (hospeda os vídeos publicamente) ---
# Bucket único compartilhado entre todas as empresas — cada uma fica em
# uma pastinha separada (`tenants/{empresaId}/...`).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Postgres (Neon) ---
# Criar projeto em: console.neon.tech → New Project → copia "Connection string".
DATABASE_URL=

# --- Chave mestra de criptografia ---
# Gere com:  openssl rand -base64 32
# Se você perder essa chave, os segredos das empresas no banco viram lixo.
ENCRYPTION_KEY=

# =========================================================
# F2.2 — Frontend Next.js + Clerk
# =========================================================

# --- Clerk (login) ---
# Criar conta em: https://clerk.com → New application
# Copia "API Keys" do dashboard (modo dev).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email do admin (você). Quando esse email logar no app, vira automaticamente
# admin do sistema e dono da empresa "swell". Use o mesmo email que vai cadastrar
# no Clerk como seu login.
# ⚠️  Precisa bater EXATAMENTE com o email do Clerk (case-sensitive em algumas
# verificações). Se não bater, o login funciona mas o app mostra "Nenhuma
# empresa vinculada".
SWELL_ADMIN_EMAIL=

# =========================================================
# F3.A — Notion OAuth (cliente novo conecta com 1 clique)
# =========================================================
# Criar em: https://www.notion.so/my-integrations → "New integration" →
# Type=Public. Em "OAuth Domain & URIs" coloque a redirect URI abaixo
# (uma pra dev, outra pra prod). Copie Client ID + Client Secret.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Dev: http://localhost:4488/api/notion/oauth/callback
# Prod: https://SEU-DOMINIO.vercel.app/api/notion/oauth/callback
NOTION_OAUTH_REDIRECT_URI=

# =========================================================
# Chaves LEGADAS — só necessárias na PRIMEIRA execução do
# scripts/migrate-swell-tenant.ts (que copia esses valores
# pro banco cifrado). Depois disso pode apagar daqui.
# =========================================================

# --- Notion (Swell) — só pra migração inicial ---
NOTION_API_KEY=
NOTION_DB_ID=

# --- Notion clientes (multi-cliente via Profiles do Zernio) — fallback Swell ---
# Banco separado do principal: cada linha = 1 cliente (ex: Austral, Metroval).
# Schema (criar no Notion uma vez): ClientId (title), Nome, ZernioProfileId,
# InstagramAccountId, YouTubeAccountId, TikTokAccountId, LinkedInAccountId (rich_text),
# Status (select: "Pendente Conexão" | "Ativo" | "Inativo").
# Cole esse env só pra Swell (legacy/default); outras empresas guardam em
# tenant_secrets.notion_clients_db_id quando criarem clientes próprios.
NOTION_CLIENTS_DB_ID=

# --- Zernio (Swell) — só pra migração inicial ---
ZERNIO_API_KEY=
ZERNIO_YOUTUBE_ACCOUNT_ID=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_LINKEDIN_ACCOUNT_ID=

# =========================================================
# Observabilidade (opcional — sem isso o app roda, só voa cego)
# =========================================================

# --- Sentry (captura de erros) ---
# Criar projeto Next.js em https://sentry.io. Sem DSN, o Sentry vira no-op.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_APP_VERSION=

# --- Healthchecks.io (dead man's switch nos crons) ---
# Crie 1 check por cron em https://healthchecks.io e cole a URL "ping".
# Sem URL, o cron pinga ninguém.
HEALTHCHECKS_PUBLICAR_APROVADOS_URL=
HEALTHCHECKS_SINCRONIZAR_EDITS_URL=
HEALTHCHECKS_ATUALIZAR_PENDENTES_URL=

# =========================================================
# Documentos legais (sem env vars — só notas)
# =========================================================
# Termos de Uso:           /termos        (Server Component estático)
# Política de Privacidade: /privacidade   (Server Component estático, LGPD-compliant)
# Aceite:                  POST /api/aceitar-termos  (grava users.termos_aceitos)
# Bloqueio do app:         <AceiteTermosGate> wrapper em /app e /convite/[token]
# Versão vigente:          v1, 30/06/2026 (definida nos próprios .tsx)
# Se precisar bumpar a versão e invalidar aceites antigos, adicione coluna
# `termos_versao` em users e compare lá. Hoje basta limpar termos_aceitos.
